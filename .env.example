# ===========================================
# CREATIVE MEDIA CO-PILOT - ENVIRONMENT VARIABLES
# ===========================================

# ===========================================
# GROQ API KEYS (Required - 4 keys recommended)
# ===========================================
# Get free keys at: https://console.groq.com
# Note: All keys from same account share 6000 TPM limit
# For best results, use keys from different Groq accounts

GROQ_API_KEY_1=gsk_your_first_groq_key_here
GROQ_API_KEY_2=gsk_your_second_groq_key_here
GROQ_API_KEY_3=gsk_your_third_groq_key_here
GROQ_API_KEY_4=gsk_your_fourth_groq_key_here

# ===========================================
# OPENROUTER API KEY (Required for Research Agent)
# ===========================================
# Get free key at: https://openrouter.ai
# Used for Qwen 2.5-72B model (free tier available)

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# ===========================================
# SERPER API KEY (Optional - for web search)
# ===========================================
# Get free key at: https://serper.dev (2500 free searches)
# Used by Research Agent for market intelligence
# If not set, research will work with limited functionality

SERPER_API_KEY=your_serper_api_key_here

# ===========================================
# HUGGINGFACE TOKEN (Required for Image Generation)
# ===========================================
# Get free token at: https://huggingface.co/settings/tokens
# Used for FLUX.1-dev image generation

HUGGINGFACE_TOKEN=hf_your_huggingface_token_here

# ===========================================
# LANGCHAIN CONFIGURATION (Optional)
# ===========================================
# Uncomment to enable LangSmith tracing for debugging

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_PROJECT=creative-media-copilot

# ===========================================
# DEMO MODE (Optional - for testing)
# ===========================================
# Set to 'true' to enable demo mode (no API calls)
# Useful for UI testing without using API credits

# DEMO_MODE=false

# ===========================================
# SETUP CHECKLIST
# ===========================================
# [ ] GROQ_API_KEY_1-4 set (at least 2 keys)
# [ ] OPENROUTER_API_KEY set
# [ ] HUGGINGFACE_TOKEN set
# [ ] SERPER_API_KEY set (optional)
# [ ] SUPABASE_URL set
# [ ] SUPABASE_KEY set
# [ ] Supabase campaigns table created (see SUPABASE_SETUP.md)
# [ ] Run: pip install -r requirements.txt
# [ ] Test: python src/database/supabase_db.py
# [ ] Launch: python app.py

# ===========================================
# NOTES
# ===========================================
# - Never commit this file with real keys to Git
# - Copy this file to .env and fill in your actual keys
# - For production, use environment variables or secrets manager
# - Free tier limits:
#   * Groq: 6000 TPM per account
#   * OpenRouter: Free tier available
#   * Serper: 2500 searches/month free
#   * HuggingFace: Free tier available
#   * Supabase: 500MB database free

# ===========================================
# RATE LIMIT INFO
# ===========================================
# Each campaign uses ~5980 tokens (99% of Groq limit)
# Wait 60 seconds between campaigns if using single account
# Use different Groq accounts for keys to avoid shared limits
# Uncheck "Include research" to save ~40% tokens
